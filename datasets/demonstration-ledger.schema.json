{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamloom.com/schemas/demonstration-ledger.schema.json",
  "title": "Jamloom R1 first-party rights declarations; evidence needs human review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-demonstration-ledger"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asset",
          "origin",
          "rights_owner",
          "authorization",
          "reviewer_id",
          "permissions",
          "identifiable_speakers",
          "speakers",
          "withdrawn",
          "expires_on",
          "deletion",
          "restrictions",
          "split",
          "source_group",
          "session_group",
          "phrase_group",
          "performer_group",
          "strata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "origin": {
            "enum": [
              "preserved_synthetic_fixture",
              "first_party_recording"
            ]
          },
          "rights_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_processing",
              "evaluation",
              "training"
            ],
            "properties": {
              "local_processing": {
                "type": "boolean"
              },
              "evaluation": {
                "type": "boolean"
              },
              "training": {
                "type": "boolean"
              }
            }
          },
          "identifiable_speakers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "speakers": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "authorization",
                "evaluation",
                "training",
                "local_processing"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "authorization": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "evaluation": {
                  "type": "boolean"
                },
                "training": {
                  "type": "boolean"
                },
                "local_processing": {
                  "type": "boolean"
                }
              }
            }
          },
          "withdrawn": {
            "type": "boolean"
          },
          "expires_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "deletion": {
            "const": "delete_source_and_descendants_rebuild_affected_datasets"
          },
          "restrictions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "split": {
            "enum": [
              "train",
              "dev",
              "test"
            ]
          },
          "source_group": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "session_group": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "phrase_group": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "performer_group": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "strata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "environment",
              "content"
            ],
            "properties": {
              "language": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "environment": {
                "enum": [
                  "clean",
                  "noisy",
                  "unknown"
                ]
              },
              "content": {
                "enum": [
                  "speech",
                  "laughter",
                  "environmental",
                  "synthetic_test"
                ]
              }
            }
          }
        }
      }
    }
  }
}
