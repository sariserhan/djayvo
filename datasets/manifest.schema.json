{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-r0-dataset"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asset",
          "origin",
          "rights_owner",
          "allowed_uses",
          "training_opt_in",
          "identifiable_people",
          "voice_consent",
          "authorization",
          "withdrawn",
          "retention",
          "split",
          "source_group",
          "session_group",
          "speaker_group",
          "performer_group",
          "restrictions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "origin": {
            "enum": [
              "preserved_synthetic_fixture",
              "original_r0_signal"
            ]
          },
          "rights_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "allowed_uses": {
            "type": "array",
            "items": {
              "enum": [
                "evaluation",
                "training",
                "distribution"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "training_opt_in": {
            "type": "boolean"
          },
          "identifiable_people": {
            "const": false
          },
          "voice_consent": {
            "const": "not_applicable_nonperson"
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "withdrawn": {
            "type": "boolean"
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expires_on",
              "deletion"
            ],
            "properties": {
              "expires_on": {
                "type": "string",
                "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
              },
              "deletion": {
                "const": "delete_asset_and_descendants_rebuild_if_used"
              }
            }
          },
          "split": {
            "enum": [
              "train",
              "dev",
              "test"
            ]
          },
          "source_group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "session_group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "speaker_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "performer_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "restrictions": {
            "const": "local_R0_evaluation_only_no_training_or_distribution"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamloom.com/schemas/dataset-1.0-r0.json",
  "title": "Jamloom R0 synthetic evaluation ledger; recorded/third-party ingestion fails closed"
}
