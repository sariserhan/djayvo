{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djayvo.com/schemas/performance-plan-1.0-remix.json",
  "title": "Djayvo source-driven offline remix plan (export contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed",
    "source_asset_id",
    "sample_rate",
    "ticks_per_quarter",
    "tempo_milli_bpm",
    "time_signature",
    "target_bars",
    "strategy",
    "tail_ms",
    "mix",
    "sections",
    "tracks",
    "source",
    "key",
    "analysis",
    "voice_clips",
    "voice_events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-remix"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "source_asset_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "ticks_per_quarter": {
      "const": 960
    },
    "tempo_milli_bpm": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 300000
    },
    "time_signature": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        {
          "enum": [
            2,
            4,
            8,
            16
          ]
        }
      ]
    },
    "target_bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "strategy": {
      "enum": [
        "hiphop",
        "reggae",
        "experimental",
        "baseline"
      ]
    },
    "tail_ms": {
      "type": "integer",
      "minimum": 500,
      "maximum": 10000
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_target_peak_dbfs",
        "clean_hook_instrument_duck_db"
      ],
      "properties": {
        "master_target_peak_dbfs": {
          "type": "number",
          "minimum": -24,
          "maximum": -0.1
        },
        "clean_hook_instrument_duck_db": {
          "const": -16.4781748189
        },
        "instrument_room_mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35,
          "default": 0
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start_bar",
          "bars"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_0-9]{1,64}$"
          },
          "start_bar": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "bars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument",
          "gain_db",
          "pan",
          "events"
        ],
        "properties": {
          "instrument": {
            "enum": [
              "piano",
              "bass",
              "drums"
            ]
          },
          "gain_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 12
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "events": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "$ref": "#/$defs/note"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "instrument": {
                  "const": "drums"
                }
              }
            },
            "then": {
              "properties": {
                "events": {
                  "items": {
                    "properties": {
                      "note": {
                        "enum": [
                          36,
                          38,
                          42,
                          46
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "original_rate",
        "original_frames",
        "processed_frames",
        "kind",
        "consent_confirmed"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "original_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880000
        },
        "processed_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 960000
        },
        "kind": {
          "enum": [
            "synthetic",
            "recorded"
          ]
        },
        "consent_confirmed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "consent_confirmed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tonic_midi",
        "mode"
      ],
      "properties": {
        "tonic_midi": {
          "type": "integer",
          "minimum": 48,
          "maximum": 71
        },
        "mode": {
          "const": "minor"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak",
        "rms",
        "normalization_gain",
        "pitch_hz",
        "pitch_confidence",
        "onsets",
        "phrases"
      ],
      "properties": {
        "peak": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "normalization_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "pitch_hz": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "pitch_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "onsets": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 2048
        },
        "phrases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_frame",
              "end_frame",
              "confidence"
            ],
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "end_frame": {
                "type": "integer",
                "minimum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "maxItems": 128
        }
      }
    },
    "voice_clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_frame",
          "end_frame",
          "confidence"
        ],
        "properties": {
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        }
      },
      "maxItems": 64
    },
    "voice_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_tick",
          "clip_id",
          "gain_db",
          "rate",
          "reverse",
          "pan",
          "clean"
        ],
        "properties": {
          "start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "clip_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "gain_db": {
            "type": "number",
            "minimum": -30,
            "maximum": 0
          },
          "rate": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          },
          "reverse": {
            "type": "boolean"
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "clean": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "clean": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "rate": {
                  "const": 1
                },
                "reverse": {
                  "const": false
                },
                "pan": {
                  "const": 0
                }
              }
            }
          }
        ]
      },
      "maxItems": 1024
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_tick",
        "duration_ticks",
        "note",
        "velocity"
      ],
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    }
  }
}
