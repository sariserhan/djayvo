{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "source_audio",
    "instruments",
    "execution",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-r0"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dataset_record_id",
        "dataset_sha256",
        "controller_priority",
        "fallback",
        "context_confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "dataset_record_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller_priority": {
          "const": "offline_exclusive"
        },
        "fallback": {
          "const": "reject_before_playback"
        },
        "context_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_asset",
        "channels",
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "local_asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "start_frame": {
          "const": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patch",
          "license_manifest",
          "midi_range",
          "articulations"
        ],
        "properties": {
          "patch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "license_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "midi_range": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 21,
              "maximum": 108
            },
            "minItems": 2,
            "maxItems": 2
          },
          "articulations": {
            "type": "array",
            "items": {
              "enum": [
                "normal",
                "muted"
              ]
            },
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "minItems": 1,
      "maxItems": 7
    },
    "execution": {
      "$ref": "https://djayvo.com/schemas/performance-plan-1.0-remix.json"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_voices",
        "source_voices",
        "render_timeout_seconds",
        "max_events",
        "max_effects",
        "source_seconds",
        "output_seconds",
        "allowed_patches"
      ],
      "properties": {
        "instrument_voices": {
          "const": 128
        },
        "source_voices": {
          "const": 16
        },
        "render_timeout_seconds": {
          "const": 120
        },
        "max_events": {
          "const": 10000
        },
        "max_effects": {
          "const": 5
        },
        "source_seconds": {
          "const": [
            2,
            5
          ]
        },
        "output_seconds": {
          "const": [
            20,
            40
          ]
        },
        "allowed_patches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 7
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner",
        "policy",
        "engine_sha256",
        "implementation_sha256",
        "export_format",
        "training"
      ],
      "properties": {
        "planner": {
          "const": "existing_cpp_rules/r0-1"
        },
        "policy": {
          "const": "r0-local-synthetic-evaluation-1"
        },
        "engine_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "export_format": {
          "const": "PCM16_stereo_WAV"
        },
        "training": {
          "const": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamloom.com/schemas/performance-plan-1.0-r0.json",
  "title": "Jamloom R0 canonical envelope over the shared C++ RemixPlan",
  "description": "Execution owns source identity, analysis, clips, timeline, sections, key, timed notes, voice actions and automation. The envelope adds rights, approved assets and resource policy without duplicating events. Native import validation is mandatory before execution."
}
