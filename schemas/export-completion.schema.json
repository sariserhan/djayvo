{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Djayvo completed export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0-export"},
    "status": {"const": "complete"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planning": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "candidate_sha256"],
      "properties": {
        "mode": {"enum": ["imported", "fallback"]},
        "candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "if": {"properties": {"mode": {"const": "imported"}}},
      "then": {"properties": {"candidate_sha256": {"type": "string"}}}
    },
    "artifacts": {
      "type": "array", "minItems": 4, "maxItems": 96,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["suffix", "bytes", "sha256"],
        "properties": {
          "suffix": {"type": "string", "pattern": "^\\.(hiphop|reggae|experimental|baseline|club|funk|call_response|hybrid)\\.(wav|score\\.json|report\\.json|events\\.tsv|piano\\.wav|bass\\.wav|drums\\.wav|guitar\\.wav|organ\\.wav|pad\\.wav|lead\\.wav|vocals\\.wav)$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
