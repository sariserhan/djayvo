+// A short, periodic attack can guide a melody; noise must retain the rhythm-only fallback.
+double attack_pitch(const AudioBuffer& source,std::uint64_t onset) {
+    const auto begin=static_cast<std::size_t>(onset); // make_remix validated the source bounds
+    const auto stride=std::max(1U,source.sample_rate/8000U);
+    const double rate=static_cast<double>(source.sample_rate)/stride;
+    const auto count=std::min<std::size_t>(static_cast<std::size_t>(rate*.08),(source.mono.size()-begin)/stride);
+    if (count<static_cast<std::size_t>(rate*.05)) return 0;
+    std::vector<double> samples(count);
+    double mean=0,power=0;
+    for (std::size_t i=0;i<count;++i) {
+        double value=0;
+        for (unsigned j=0;j<stride;++j) value+=source.mono[begin+i*stride+j];
+        samples[i]=value/stride;mean+=samples[i];
+    }
+    mean/=static_cast<double>(count);
+    for (auto& x:samples) {x-=mean;power+=x*x;}
+    if (power/static_cast<double>(count)<.0005*.0005) return 0;
+    const auto low=static_cast<std::size_t>(std::ceil(rate/450)),high=static_cast<std::size_t>(rate/70);
+    std::vector<double> difference(high+1,1);
+    double cumulative=0;
+    for (std::size_t lag=1;lag<=high;++lag) {
+        double square=0;
+        for (std::size_t i=0;i<count/2;++i) {
+            const auto delta=samples[i]-samples[i+lag];square+=delta*delta;
+        }
+        cumulative+=square;
+        difference[lag]=cumulative>0?square*static_cast<double>(lag)/cumulative:1;
+    }
+    // First good minimum avoids choosing an integer multiple of the fundamental period.
+    for (std::size_t lag=2;lag<high;++lag) {
+        if (difference[lag]>=.12) continue;
+        while (lag<high && difference[lag+1]<difference[lag]) ++lag;
+        if (lag<low || lag==high) return 0;
+        const auto curve=difference[lag-1]-2*difference[lag]+difference[lag+1];
+        const auto adjustment=curve>0?std::clamp((difference[lag-1]-difference[lag+1])/(2*curve),-.5,.5):0;
+        return rate/(static_cast<double>(lag)+adjustment);
+    }
+    return 0;
+}
