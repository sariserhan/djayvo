+void source_pitch_contour() {
+    using Notes=std::vector<int>;
+    const auto pitches=[](const djayvo::RemixPlan& plan) {
+        Notes notes;const auto bar=djayvo::ticks_per_bar(plan.music);
+        for (const auto& note:plan.music.tracks[0].notes)
+            if (note.start>=5*bar && note.start<7*bar) notes.push_back(note.pitch);
+        return notes;
+    };
+    Notes reference;
+    for (unsigned rate:{8000U,44100U,48000U,192000U}) {
+        auto audio=source();audio.sample_rate=rate;audio.mono.assign(rate*3,0);
+        djayvo::InputAnalysis features;features.normalization_gain=1;features.peak=.8;features.rms=.1;
+        features.phrases={{0,rate*3ULL,1}};
+        for (unsigned ms:{100U,400U,900U,1400U,2200U}) features.onsets.push_back(rate*ms/1000U);
+        const auto fill=[&](bool rising,bool harmonics,double gain,double offset) {
+            std::fill(audio.mono.begin(),audio.mono.end(),static_cast<float>(offset));
+            const std::array<double,5> frequencies{{140,180,220,280,350}};
+            for (std::size_t n=0;n<5;++n) for (unsigned i=0;i<rate/10;++i) {
+                const double phase=6.283185307179586*frequencies[rising?n:4-n]*i/rate;
+                audio.mono[features.onsets[n]+i]=static_cast<float>(offset+gain*(harmonics?
+                    .2*std::sin(phase)+.3*std::sin(2*phase)+.15*std::sin(3*phase):.3*std::sin(phase)));
+            }
+        };
+        const auto plan=[&] {return djayvo::make_remix(audio,features,djayvo::Strategy::call_response,4123,true,false);};
+        fill(true,false,1,0);const auto rising=pitches(plan());
+        fill(false,false,1,0);const auto falling=pitches(plan());
+        check(rising.size()==5 && falling.size()==5,"pitch tracking changed the source rhythm");
+        check(rising!=falling,"instrumental melody ignores rising versus falling source pitch");
+        check(rising[0]<rising[3] && falling[0]>falling[3],"melody reverses the voiced contour");
+        if (reference.empty()) reference=rising;
+        check(reference==rising,"contour depends on the source sample rate");
+        fill(true,true,.5,.15);
+        check(pitches(plan())==rising,"harmonics, gain or DC offset change the inferred melody");
+        // Leave a consonant-like, unpitched first attack before the voiced contour.
+        std::fill(audio.mono.begin()+static_cast<std::ptrdiff_t>(features.onsets[0]),
+                  audio.mono.begin()+static_cast<std::ptrdiff_t>(features.onsets[0]+rate/10),.15F);
+        const auto mixed=pitches(plan());check(mixed.size()==5,"unvoiced attacks disappear");
+        check(mixed[1]<mixed[3],"unvoiced attack poisons the melodic anchor");
+        std::uint32_t random=4123;
+        for (auto& sample:audio.mono) {random^=random<<13U;random^=random>>17U;random^=random<<5U;
+            sample=static_cast<float>(static_cast<int>(random%20001)-10000)/50000;}
+        const auto noise=pitches(plan());
+        for (double frequency:{30.,500.,1000.}) {
+            for (std::size_t i=0;i<audio.mono.size();++i)
+                audio.mono[i]=static_cast<float>(.3*std::sin(6.283185307179586*frequency*i/rate));
+            check(pitches(plan())==noise,"out-of-range periodic sound creates a subharmonic melody");
+        }
+        for (auto& sample:audio.mono) sample=.1F; // no measurable local periodicity
+        check(pitches(plan())==noise,"noise receives a spurious pitched melody");
+        features.onsets.back()=audio.mono.size()-1;
+        djayvo::validate(plan(),audio); // insufficient trailing audio must safely fall back
+    }
+}
