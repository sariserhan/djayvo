{
  "name": "jamloom-pro",
  "productName": "Jamloom Pro",
  "version": "1.0.0",
  "private": true,
  "description": "Jamloom Performance Studio for Mac",
  "author": "Jamloom",
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare:studio": "sh ../../scripts/web_build.sh && python3 ../../scripts/verify_web_bundle.py > /dev/null",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node tests/app.mjs",
    "package": "npm run prepare:studio && node package.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "@electron/packager": "20.3.0"
  }
}
