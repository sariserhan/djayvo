# Reference for Vercel Production variables; not a working credentials file.
# Keep localhost in .env.local and use separate resources for previews.
DATABASE_URL=
BETTER_AUTH_URL=https://jamloom.com
BETTER_AUTH_SECRET=
# Resend remains deferred. Set both only after verifying the sending domain.
RESEND_API_KEY=
EMAIL_FROM=
# Planned sender after verification: Jamloom <hello@jamloom.com>
# Enable only after live upload/playback/deletion, CORS and cleanup validation.
JAMLOOM_R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=jamloom-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JAMLOOM_CATALOGUE_ENABLED=false
JAMLOOM_REVIEWER_EMAILS=
# Never deploy local outbox/audio paths or a Cloudflare management token.
# Migration credentials belong in the separate explicit migration workflow.
