# Reference for Vercel Production variables; not a working credentials file.
# Keep localhost in .env.local and use separate resources for previews.
# Public launch gate defaults on. Set false and redeploy only when ready to open.
JAMLOOM_COMING_SOON=true
DATABASE_URL=
# Set only after the signed/notarized Apple silicon companion is published.
JAMLOOM_COMPANION_DOWNLOAD_URL=
BETTER_AUTH_URL=https://www.jamloom.com
BETTER_AUTH_SECRET=
# Supply the sending key after verifying jamloom.com in Resend.
RESEND_API_KEY=
EMAIL_FROM="Jamloom <hello@jamloom.com>"
EMAIL_REPLY_TO=support@jamloom.com
# Enable only after live upload/playback/deletion, CORS and cleanup validation.
JAMLOOM_R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=jamloom-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Curated Music DNA examples use these same credentials independently of library
# enablement. Apply 0017_music_storage before using the new library/song persistence.
# Finished music keys: <product>/<public|private>/<id>/<sha256>.wav.
# The bucket stays private; public playback is an app-authorized signed grant.
JAMLOOM_CATALOGUE_ENABLED=false
JAMLOOM_REVIEWER_EMAILS=
# Never deploy local outbox/audio paths or a Cloudflare management token.
# Migration credentials belong in the separate explicit migration workflow.

# Sandbox verification only. These settings never enable public purchases.
# Keep Stripe sandbox credentials separate from the live configuration below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Preserve the existing app identity; changing it requires an explicit migration.
APPLE_BUNDLE_ID=com.djayvo.app
# Comma-separated base64 DER Apple root certificates from Apple PKI (public data).
APPLE_ROOT_CERTIFICATES_BASE64=

# Separate Academy test catalog; sales remain gated.
ACADEMY_STRIPE_SANDBOX_ENABLED=false
ACADEMY_STRIPE_PRODUCT_ID=
ACADEMY_STRIPE_PRICE_ID=
ACADEMY_STRIPE_WEBHOOK_SECRET=

# Admin live-mode configuration is separate; it does not release paid products.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
ACADEMY_STRIPE_LIVE_PRODUCT_ID=
ACADEMY_STRIPE_LIVE_PRICE_ID=
ACADEMY_STRIPE_LIVE_WEBHOOK_SECRET=
# >=32 random characters; Bearer authorization for GET /api/notifications.
CRON_SECRET=

# Separate read-only partner music; never reuse the private user-audio bucket.
R2_AUROWALL_ACCOUNT_ID=
R2_AUROWALL_BUCKET=
R2_AUROWALL_ACCESS_KEY_ID=
R2_AUROWALL_SECRET_ACCESS_KEY=
# CDN URL may remain configured; streaming uses the authenticated S3 API.
R2_AUROWALL_CDN_URL=

# Hosted songs: migration 0018 and the updated worker must be released first.
# See ../../docs/hosted-songs.md. These defaults keep purchases/generation closed.
JAMLOOM_CLOUD_SONGS_ENABLED=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
JAMLOOM_CLOUD_RATE_MICROS_PER_SECOND=
JAMLOOM_CLOUD_DAILY_CAP_MICROS=20000000
CREDIT_BILLING_MODE=live
JAMLOOM_CREDIT_PURCHASES_ENABLED=false
# Owner selected 2026-10-23: General - Electronically Supplied Services.
CREDIT_STRIPE_TAX_CODE=txcd_10000000
CREDIT_STRIPE_LIVE_WEBHOOK_SECRET=
# Existing CRON_SECRET also authenticates /api/song-jobs (every minute).
