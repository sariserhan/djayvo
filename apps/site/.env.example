# Copy to .env.local. Never commit real values. Use separate Neon branches and
# distinct secrets for local, preview and production; no production data in previews.
# For jamloom.com and jamloom-audio use .env.production.example as the hosted reference.
DATABASE_URL=
# Set only after the signed/notarized Apple silicon companion is published.
JAMLOOM_COMPANION_DOWNLOAD_URL=
# Neon CLI supplies this direct connection for explicit migrations only.
DATABASE_URL_UNPOOLED=
# Optional legacy override for migrations; omit when using Neon CLI variables.
DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Single receiving mailbox; outgoing-only senders need a monitored reply address.
EMAIL_REPLY_TO=
# Local app only (including with Neon): capture emails outside public/ in an ignored directory.
# JAMLOOM_LOCAL_OUTBOX=/absolute/path/to/jamloom/build-site/outbox
# Local loopback Postgres only; never use with Neon.
# JAMLOOM_LOCAL_AUDIO_DIR=/absolute/path/to/jamloom/build-site/private-audio
# Enable only after isolated live R2 validation, CORS, lifecycle and budget review.
JAMLOOM_R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Hosted catalogue stays off until rights, moderation, privacy and provider gates pass.
JAMLOOM_CATALOGUE_ENABLED=false
# Comma-separated verified account emails. No reviewers are enabled by default.
JAMLOOM_REVIEWER_EMAILS=

# JAMLOOM_* settings take precedence; existing DJAYVO_* names remain supported.

# Sandbox verification only. These settings never enable public purchases.
# Keep Stripe sandbox credentials separate from the live configuration below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preserve the existing app identity; changing it requires an explicit migration.
APPLE_BUNDLE_ID=com.djayvo.app
# Comma-separated base64 DER Apple root certificates from Apple PKI (public data).
APPLE_ROOT_CERTIFICATES_BASE64=

# DJ Academy uses a separate $79.99 one-time sandbox catalog and webhook.
# This flag never enables live billing or music generation.
ACADEMY_STRIPE_SANDBOX_ENABLED=false
ACADEMY_STRIPE_PRODUCT_ID=
ACADEMY_STRIPE_PRICE_ID=
ACADEMY_STRIPE_WEBHOOK_SECRET=

# Admin live-mode configuration is separate; it does not release paid products.
STRIPE_LIVE_SECRET_KEY=
ACADEMY_STRIPE_LIVE_PRODUCT_ID=
ACADEMY_STRIPE_LIVE_PRICE_ID=
ACADEMY_STRIPE_LIVE_WEBHOOK_SECRET=
# >=32 random characters; Bearer authorization for GET /api/notifications.
CRON_SECRET=

# Optional loopback-only Mac singer preview. Absolute repo root; leave empty on hosted servers.
# Setup and model prerequisites: ../../docs/music-dna-songs.md
# Required audio-style auditor: ../../docs/music-dna-fit.md
JAMLOOM_DNA_SINGER_ROOT=
