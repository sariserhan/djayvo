# Copy to .env.local. Never commit real values. Use separate Neon branches and
# distinct secrets for local, preview and production; no production data in previews.
DATABASE_URL=
# Direct (non-pooler) Neon connection for explicit migrations only.
DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Local loopback Postgres only: capture test emails outside public/ in an ignored directory.
# DJAYVO_LOCAL_OUTBOX=/absolute/path/to/djayvo/build-site/outbox
# DJAYVO_LOCAL_AUDIO_DIR=/absolute/path/to/djayvo/build-site/private-audio
# Enable only after isolated live R2 validation, CORS, lifecycle and budget review.
DJAYVO_R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
