{
  "name": "jamloom-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "studio:prepare": "node scripts/prepare-studio.mjs",
    "predev": "npm run studio:prepare",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run studio:prepare",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "test": "tsx --test tests/config.test.ts tests/audio.test.ts tests/email.test.ts tests/economics.test.ts tests/taste.test.ts tests/apple-payments.test.ts tests/generation-budget.test.ts",
    "test:integration": "tsx --test tests/database.test.ts tests/private-audio.test.ts tests/catalogue.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:neon": "node --import tsx tests/neon.mjs",
    "test:r2": "tsx tests/r2-live.ts",
    "test:email-browser": "tsx tests/email-browser.ts",
    "test:catalogue-browser": "TSX_DISABLE_CACHE=1 NODE_DISABLE_COMPILE_CACHE=1 node --import tsx tests/catalogue-browser.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:usage": "tsx scripts/usage.ts",
    "audio:cleanup": "tsx scripts/cleanup-audio.ts",
    "auth:cleanup": "tsx scripts/cleanup-auth.ts",
    "test:wallet": "tsx --test tests/wallet.test.ts tests/generation-queue.test.ts tests/generation-watchdog.test.ts tests/vast-provider.test.ts",
    "generation:watchdog": "tsx scripts/generation-watchdog.ts",
    "test:product-browser": "node tests/product-browser.mjs",
    "test:product-a11y": "node tests/product-a11y.mjs",
    "test:product-http": "node --import tsx tests/product-http.mjs",
    "test:generation-render": "tsx tests/generation-render-smoke.ts",
    "test:audio-variety": "node tests/audio-variety-audit.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@vercel/functions": "3.10.1",
    "better-auth": "1.7.10",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
